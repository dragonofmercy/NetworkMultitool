<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <CSII_Managed>$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</CSII_Managed>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Geometry\**\*.cs" />
        <Compile Include="..\Net\NodeChain.cs" Condition="Exists('..\Net\NodeChain.cs')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Unity.Mathematics">
            <HintPath>$(CSII_Managed)\Unity.Mathematics.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Colossal.Mathematics">
            <HintPath>$(CSII_Managed)\Colossal.Mathematics.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <HintPath>$(CSII_Managed)\Unity.Collections.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Unity.Burst">
            <HintPath>$(CSII_Managed)\Unity.Burst.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

</Project>
